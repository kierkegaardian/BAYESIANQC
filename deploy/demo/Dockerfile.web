FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --include=dev \
    && npm audit --audit-level=high

COPY frontend ./
COPY samples /app/samples

ARG VITE_API_URL=/api
ARG CLIENT_MODE=edge-basic
ARG VITE_DEPLOYMENT_MODE=stakeholder

RUN VITE_API_URL="$VITE_API_URL" \
    VITE_AUTH_MODE="$CLIENT_MODE" \
    VITE_DEPLOYMENT_MODE="$VITE_DEPLOYMENT_MODE" \
    npm run build

FROM nginx:1.29.4-alpine@sha256:4870c12cd2ca986de501a804b4f506ad3875a0b1874940ba0a2c7f763f1855b2

COPY deploy/demo/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

RUN chown -R nginx:nginx /usr/share/nginx/html

USER nginx
EXPOSE 8080
