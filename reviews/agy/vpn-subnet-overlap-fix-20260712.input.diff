+def test_demo_networks_do_not_overlap_roadtrip_vpn() -> None:
+    compose = (ROOT / "deploy/demo/docker-compose.yml").read_text(encoding="utf-8")
+    subnets = [ip_network(value) for value in re.findall(r"subnet:\s*(\S+)", compose)]
+
