+++ b/frontend/src/pages/chartControlLimits.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+
+import { buildControlLimitSteps, type ProvenanceRecord } from "./chartControlLimits";
+
